# ============ ORTAM ============
NODE_ENV=development
APP_ENV=development
PORT=3000
SERVE_WEB=false

# ============ JWT ============
# Üret: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-min-32-chars

# ============ DATABASE (Render Postgres) ============
# Local Node development uses the public URL; Render's Docker service uses the private URL.
# External URLs require TLS (`sslmode=require`). Keep these connection strings out of Git.
DB_CONNECTION_MODE=external
DB_EXTERNAL_URL=postgres://USER:PASSWORD@PUBLIC_HOST:5432/DATABASE?sslmode=require
DB_INTERNAL_URL=postgres://USER:PASSWORD@INTERNAL_HOST:5432/DATABASE
# Legacy fallback for deployments that have not migrated to DB_CONNECTION_MODE.
DATABASE_URL=

# ============ CLOVER — clover3 (HamzaMedine) ============
CLOVER_HAMZA_MERCHANT_ID=
CLOVER_HAMZA_PUBLIC_KEY=
CLOVER_HAMZA_PRIVATE_KEY=
CLOVER_HAMZA_ECOMMERCE_PRIVATE_KEY=
CLOVER_HAMZA_API_TOKEN=

# ============ CLOVER — SNSAUTO (S&S Auto express) ============
CLOVER_SNS_MERCHANT_ID=
CLOVER_SNS_PUBLIC_KEY=
CLOVER_SNS_PRIVATE_KEY=
CLOVER_SNS_ECOMMERCE_PRIVATE_KEY=
CLOVER_SNS_API_TOKEN=
CLOVER_SNS_CURRENCY=CAD

# ============ AUTHORIZE.NET — HamzaMedine ============
AUTHORIZE_HAMZA_USERNAME=
AUTHORIZE_HAMZA_PASSWORD=
AUTHORIZE_HAMZA_LOGIN_ID=
AUTHORIZE_HAMZA_TXN_KEY=
AUTHORIZE_HAMZA_CLIENT_KEY=
AUTHORIZE_HAMZA_SIG_KEY=

# ============ DİĞER (opsiyonel) ============
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_SUBSCRIPTION_PRODUCT_NAME=
# Integer in the currency's minor unit (for example, 2000 = 20.00 USD)
STRIPE_SUBSCRIPTION_UNIT_AMOUNT=
STRIPE_SUBSCRIPTION_CURRENCY=usd
STRIPE_SUBSCRIPTION_INTERVAL=month
STRIPE_SUBSCRIPTION_INTERVAL_COUNT=1
# Both URLs must use HTTPS. Example success URL: https://your-domain/checkout-success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_SUCCESS_URL=
# Example cancel URL: https://your-domain/stripe-checkout
STRIPE_CHECKOUT_CANCEL_URL=
MONERIS_ENABLED=false
MYPOS_ENABLED=false

# ============ REALTIME MESSAGING HUB ==========
# Set the same random secret in the Node API and ASP.NET SignalR service in production.
SIGNALR_INTERNAL_SECRET=
SIGNALR_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NODE_API_URL=http://127.0.0.1:3000
