# Copy to .env and replace every placeholder before starting Docker Compose.
POSTGRES_USER=posapp
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=posdb

JWT_SECRET=replace-with-at-least-32-random-characters
CVV_SALT=replace-with-a-separate-random-value
PROCESSOR_VAULT_KEY=
SIGNALR_INTERNAL_SECRET=replace-with-a-separate-long-random-secret
WEB_ORIGIN=http://localhost:8080

WEB_PORT=8080
