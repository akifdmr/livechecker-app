{
  "info": {
    "name": "Manager - User Accounts",
    "description": "Hesap kayıt/giriş, profil güncelleme ve admin kullanıcı yönetimi endpointleri.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "newUsername",
      "value": "new.user"
    },
    {
      "key": "newPassword",
      "value": "ChangeThis123!"
    },
    {
      "key": "loginUsername",
      "value": ""
    },
    {
      "key": "loginPassword",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "newAdminPassword",
      "value": "ChangeThis123!"
    },
    {
      "key": "checkoutSessionId",
      "value": ""
    },
    {
      "key": "checkoutUrl",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Public Auth",
      "item": [
        {
          "name": "Create account (starts with 0 credits)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{newUsername}}\",\n  \"password\": \"{{newPassword}}\",\n  \"displayName\": \"New User\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Self-registration creates an active viewer account with 0 credits. It cannot perform write/operation requests until credited."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('userId', data.user.id);",
                  "  pm.collectionVariables.set('loginUsername', pm.collectionVariables.get('newUsername'));",
                  "  pm.collectionVariables.set('loginPassword', pm.collectionVariables.get('newPassword'));",
                  "  pm.test('New account has zero credits', () => pm.expect(Number(data.user.credits)).to.eql(0));",
                  "  pm.test('New account is viewer', () => pm.expect(data.user.role).to.eql('viewer'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (stores bearer token)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{loginUsername}}\",\n  \"password\": \"{{loginPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('token', data.token);",
                  "  pm.collectionVariables.set('userId', data.user.id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "My Account",
      "item": [
        {
          "name": "Get current account",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "Update my profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{loginUsername}}\",\n  \"displayName\": \"Updated Name\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "profile"
              ]
            }
          }
        },
        {
          "name": "Change my password",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{loginPassword}}\",\n  \"newPassword\": \"{{newAdminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "profile"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.set('loginPassword', pm.collectionVariables.get('newAdminPassword'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin - Users (admin token required)",
      "item": [
        {
          "name": "List users and online status",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users"
              ]
            },
            "description": "Returns is_online and last_seen_at for each account."
          }
        },
        {
          "name": "Get user's safe detail data",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/users/{{userId}}/details?limit=500",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users",
                "{{userId}}",
                "details"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "500"
                }
              ]
            },
            "description": "Admin-only account profile, credits, tokenized enrollment metadata, payment activity and masked audit records. Secret values and raw card data are excluded."
          }
        },
        {
          "name": "Block user",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_active\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users",
                "{{userId}}"
              ]
            }
          }
        },
        {
          "name": "Unblock user",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users",
                "{{userId}}"
              ]
            }
          }
        },
        {
          "name": "Change user's username",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"replacement.user\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users",
                "{{userId}}"
              ]
            },
            "description": "Username is case-insensitively unique. A duplicate returns HTTP 409."
          }
        },
        {
          "name": "Set user's password",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{newAdminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users",
                "{{userId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Stripe Hosted Checkout",
      "description": "Hosted subscription flow. Server-side Stripe test configuration is required. No card data is sent to this API.",
      "item": [
        {
          "name": "Create subscription Checkout session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/payments/stripe/checkout-session",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "stripe",
                "checkout-session"
              ]
            },
            "description": "Returns sessionId and checkoutUrl. Follow checkoutUrl in a browser to use Stripe-hosted Checkout."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Checkout session created\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.sessionId).to.be.a(\"string\");",
                  "  pm.expect(body.checkoutUrl).to.match(/^https:\\/\\/checkout\\.stripe\\.com\\//);",
                  "  pm.collectionVariables.set(\"checkoutSessionId\", body.sessionId);",
                  "  pm.collectionVariables.set(\"checkoutUrl\", body.checkoutUrl);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Checkout session status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/payments/stripe/checkout-session/{{checkoutSessionId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "stripe",
                "checkout-session",
                "{{checkoutSessionId}}",
                "status"
              ]
            },
            "description": "Verifies only the signed-in account owner’s session. Status is retrieved from Stripe."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Checkout status returned\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.expect([\"complete\", \"open\", \"expired\"]).to.include(body.status);",
                  "  pm.expect([\"paid\", \"unpaid\", \"no_payment_required\"]).to.include(body.paymentStatus);",
                  "  pm.expect(body.subscriptionCreated).to.be.a(\"boolean\");",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
